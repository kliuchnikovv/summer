# --- AI provider: OpenRouter (one key for all models) ---
# Leave BLANK to run in deterministic mock mode (app boots & demos with zero keys).
# Set a real OpenRouter key to enable real markdown parsing, OCR and summarization.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-role models (OpenRouter ids). Defaults match the task's requested models:
OPENROUTER_PARSE_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_SUMMARY_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_OCR_MODEL=openai/gpt-5-mini
# Cap output tokens per call (cost control; lower if your key has a small balance)
OPENROUTER_MAX_TOKENS=4096

# --- Upload limits ---
MAX_UPLOAD_BYTES=20971520   # 20 MB, aligned to Gemini's inline limit
GEMINI_MAX_PAGES=1000       # reject what Gemini can't process

# --- Auth ---
# API keys for curl / programmatic access: comma-separated "key:principal" pairs
API_KEYS=demo-key:demo-user,demo-key-2:second-user
# Login accounts for the web UI: "username:password:principal:daily_limit" (comma-separated).
# daily_limit is optional (falls back to DAILY_LIMIT). The test account is capped at 10/day.
ACCOUNTS=tester:test-pass-123:tester:10

# --- Rate limits (per principal) ---
DAILY_LIMIT=100     # max API calls per calendar day
MAX_CONCURRENT=5    # max documents in processing at once
RATE_PER_MIN=30     # short-window burst cap

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
